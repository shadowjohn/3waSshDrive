<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>ThreeWa.SshDrive.App</RootNamespace>
    <AssemblyName>3waSshDrive</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ThreeWaDisplayVersion Condition="'$(ThreeWaDisplayVersion)' == ''">v2026.09.19.01</ThreeWaDisplayVersion>
    <ThreeWaPackageVersion Condition="'$(ThreeWaPackageVersion)' == ''">2026.919.1</ThreeWaPackageVersion>
    <ThreeWaAssemblyVersion Condition="'$(ThreeWaAssemblyVersion)' == ''">2026.9.19.1</ThreeWaAssemblyVersion>
    <Version>$(ThreeWaPackageVersion)</Version>
    <AssemblyVersion>$(ThreeWaAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ThreeWaAssemblyVersion)</FileVersion>
    <InformationalVersion>$(ThreeWaDisplayVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Authors>羽山秋人</Authors>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="VelopackPackageVersion" Value="$(ThreeWaPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\3waSshDrive.Core\3waSshDrive.Core.csproj" />
    <ProjectReference Include="..\3waSshDrive.Sftp\3waSshDrive.Sftp.csproj" />
    <ProjectReference Include="..\3waSshDrive.FileSystem\3waSshDrive.FileSystem.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\runtime\winfsp-2.1.25156-manifest.json"
          Link="runtime\winfsp-2.1.25156-manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\mascot.mp4"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\mascot2.mp4"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\mascot.jpg"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\app.ico"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\header_logo.png"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\mascot_card.png"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\background.jpg"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\background.png"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\mascot.jpg" />
    <EmbeddedResource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\header_logo.png" />
    <EmbeddedResource Include="Assets\mascot_card.png" />
    <EmbeddedResource Include="Assets\background.jpg" />
    <EmbeddedResource Include="Assets\background.png" />
  </ItemGroup>
</Project>
