<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Fsp</RootNamespace>
    <AssemblyName>3waSshDrive.WinFsp</AssemblyName>
    <!-- Interop.Api derives the native DLL/registry names and compatibility
         check from these assembly attributes. Keep them aligned with WinFsp. -->
    <Product>WinFsp</Product>
    <FileVersion>2.1.0.0</FileVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\third_party\winfsp\src\dotnet\FileSystemBase+Const.cs" Link="Upstream\FileSystemBase+Const.cs" />
    <Compile Include="..\..\third_party\winfsp\src\dotnet\FileSystemBase.cs" Link="Upstream\FileSystemBase.cs" />
    <Compile Include="..\..\third_party\winfsp\src\dotnet\FileSystemHost.cs" Link="Upstream\FileSystemHost.cs" />
    <Compile Include="..\..\third_party\winfsp\src\dotnet\Interop.cs" Link="Upstream\Interop.cs" />
  </ItemGroup>
</Project>
